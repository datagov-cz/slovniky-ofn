                  dct:title  "český překlad výkladového slovníku TOGAF"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/služba-it>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Služba poskytovaná jednomu nebo více zákazníkům poskytovatelem služeb IT. Služba IT je založena na využití informační technologie a podporuje podnikové procesy zákazníka. Služba IT je vytvářena za pomoci personálu, procesů a techniky a měla by být definována v dohodě o úrovni služeb."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Služba IT"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/podniková-služba>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Podporuje podnikové dovednosti (business capabilities) prostřednictvím jednoznačně definovaného rozhraní a je jednoznačně formálně řízena organizací (například má SLA smlouvu)."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Podniková služba"@cs;
