        rdf:type         slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "SPM"@cs;
        skos:definition  "Proces odpovědný za správu portfolia služeb. Správa portfolia služeb pohlíží na služby z hlediska hodnoty, kterou poskytují businessu."@cs;
