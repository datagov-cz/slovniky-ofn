<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/externí-metrika>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Metrika užívaná pro měření dodávky služby IT zákazníkovi. Externí metriky jsou obvykle definovány v SLA a jsou vykazovány zákazníkům. Viz Interní metrika."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Externí metrika"@cs;
