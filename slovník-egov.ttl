                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/call-centrum>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-subjektu-práva , slovníky:třída;
        skos:definition  "Organizace nebo podniková jednotka, která zpracovává velké množství příchozích a odchozích telefonických hovorů. Viz Service Desk."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
