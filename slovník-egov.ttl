                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/účastník-aktér>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-subjektu-práva , slovníky:třída;
        dct:description  "Nezaměňovat s pojmem \\"účastník řízení\\", který je příbuzný, ale zúžený."@cs;
        skos:definition  "Osoba, organizace nebo systém, který vystupuje v roli jako účastník aktivit (byznys funkcí, procesů nebo služeb), viz aktér."@cs;
