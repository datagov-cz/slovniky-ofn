                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/kvalita-služby>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Přednastavená konfigurace nefunkčních parametrů, která může být přiřazena ke službě nebo k dohodě o poskytování služby."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
