                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://www.geobusiness.cz/wp-content/uploads/2021/12/GeoInfoStrategie2020Priloha1.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/událost>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Změna stavu, která je z procesního pohledu podstatná, může se vyskytnout vně nebo uvnitř organizace a vně nebo uvnitř organizace může být zpracována."@cs;
