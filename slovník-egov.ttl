                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/architektura-veřejné-správy>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Architektura veřejné správy jako socio-ekonomicko-technického systému je souborem prvků, které tvoří strukturu systému, jejich vzájemných vazeb, jejich chování (fungování) a principů a pravidel jejich vzniku a vývoje v průběhu času."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Architektura veřejné správy"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "Výklad OHA"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/čistá-současná-hodnota>
        rdf:type         slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "ČSH"@cs;
        skos:definition  "Technika využívaná při rozhodování o investičních nákladech. Čistá současná hodnota porovnává přírůstky a úbytky finančních toků. Kladná čistá současná hodnota indikuje hodnotnou investici. Viz Interní míra návratnosti, Návratnost investice."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Čistá současná hodnota"@cs;
