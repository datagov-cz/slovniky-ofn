<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/informační-systém-územní-identifikace>
        rdf:type         slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "ISÚI"@cs;
        skos:definition  "ISÚI je editorský systém registru územní identifikace, adres a nemovitostí, spravovaný ČUZK."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
