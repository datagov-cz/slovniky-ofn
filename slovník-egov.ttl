<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/analýza-rizik>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Proces pochopení povahy rizika a určení úrovně (pravděpodobnosti nastání a odhad možných dopadů) rizika."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Analýza rizik"@cs;
