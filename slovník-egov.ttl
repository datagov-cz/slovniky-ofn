                  dct:title  "Výklad OHA"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/mezinárodní-organizace-pro-standardizaci>
        rdf:type         slovníky:pojem , vsgov:typ-subjektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "ISO"@cs;
        skos:definition  "Mezinárodní organizace pro standardizaci (ISO) je celosvětově největším producentem norem. ISO je nevládní organizací, jež je tvořena sítí národních normalizačních institucí 156 zemí. Další informace o ISO jsou dostupné na http://www.iso.org/."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
