<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/matice-kompetencí>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Synonymum pro RACI."@cs;
