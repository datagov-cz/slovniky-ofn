<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/adresní-místo>
        rdf:type                        slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:definition                 "Takové místo v terénu, kterému lze ve vztahu ke stavebnímu objektu jednoznačně přiřadit adresu."@cs;
        skos:inScheme                   <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel                  "Adresní místo"@cs;
        slovníky:definující-ustanovení  <https://opendata.eselpoint.cz/esel-esb/eli/cz/sb/2009/111/2025-07-01/dokument/norma/cast_1/hlava_4/par_29/odst_1/pism_d> .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/cíl-úrovní-služeb>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Závazek dokumentovaný v dohodě o úrovni služeb (SLA). Cíle úrovní služeb vycházejí z požadavků na úrovně služeb a jsou potřebné k zajištění toho, aby služba IT plnila svůj účel. Cíle úrovně služeb by měly být “SMART\\" a jsou obvykle založené na klíčových ukazatelích výkonnosti (KPI)."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Cíl úrovní služeb"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/portfolio-zákazníků>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Databáze nebo strukturovaný dokument sloužící k zaznamenání všech zákazníků poskytovatele služeb IT. Portfolio zákazníků reprezentuje pohled manažera pro vztahy s businessem na zákazníky, kterým jsou poskytovány služby poskytovatele služeb IT. Viz Portfolio služeb."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Portfolio zákazníků"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/soubor-prostorových-dat>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "1) Množina souvisejících záznamů prostorových dat uložených na paměťovém médiu. \
2) Identifikovatelná množina prostorových dat, se kterou je možné společně manipulovat a která sdílí určité společné vlastnosti, zejména zdroj a způsob pořízení."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Soubor prostorových dat"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "www.geobusiness.cz/wp-content/uploads/2021/12/GeoInfoStrategie2020Priloha1.pdf"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/potenciál-služby>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Celková možná hodnota veškerých způsobilostí a zdrojů poskytovatele služeb IT."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
