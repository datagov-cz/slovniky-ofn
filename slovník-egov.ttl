                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/rámec-architektury>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Konceptuální struktura používající se pro rozvoj, implementaci a údržbu architektury."@cs;
