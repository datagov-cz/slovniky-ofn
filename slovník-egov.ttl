                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/plán-dostupnosti>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Plán, který zaručuje, že současné i budoucí požadavky na dostupnost služby IT budou poskytovány nákladově efektivním způsobem."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Plán dostupnosti"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/egovernment-cloud>
        rdf:type                        skos:Concept , slovníky:pojem , slovníky:třída , vsgov:typ-objektu-práva;
        dct:description                 "eGovernment cloud bude tvořen státními datovými centry (státní cloud) a komerčními datovými centry (komerční cloud). Ve státním cloudu budou provozovány ty ICT služby, jejichž provozování privátními subjekty není z důvodů bezpečnosti nebo utajení možné. Všechny ostatní služby mohou být poskytovány jak státním cloudem, tak komerčním cloudem tak, aby vznikl tlak na snižování cen ICT služeb."@cs;
        skos:altLabel                   "eGC"@cs;
        skos:definition                 "Způsob zajištění provozu části nebo celého informačního systému veřejné správy (ISVS) prostřednictvím dálkového přístupu k sdílenému technickému nebo programovému prostředku, který je zpřístupněný poskytovatelem cloud computingu a nastavitelný správcem ISVS."@cs;
        skos:inScheme                   <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel                  "eGovernment cloud"@cs;
        slovníky:definující-ustanovení  <https://opendata.eselpoint.cz/esel-esb/eli/cz/sb/2000/365/2025-11-01/dokument/norma/cast_1/hlava_1/par_2/odst_2/pism_b> .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/správa-zdrojů>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        dct:description  "Zdroje jsou: \
- finanční, \
- personální, \
- datové, \
- technologické (včetně konfigurací)\
Patří do taktického řízení"@cs;
        skos:definition  "Identifikace, odhad, přidělení a sledování prostředků použitých k vývoji produktu nebo k provedení služby"@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Správa zdrojů"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
