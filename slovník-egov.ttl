                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/informační-technologie>
        rdf:type         slovníky:třída , vsgov:typ-objektu-práva , slovníky:pojem , skos:Concept;
        dct:description  "Nejde tedy pouze o technologie jako takové, ale o celé odvětví., tedy i o lidi, budovy, metodiky a pravidla apod."@cs;
        skos:altLabel    "IT"@cs;
        skos:definition  "Zastřešující termín, který buď představuje všechny nebo některé oblasti počítačového odvětví jako: Rozvoj, Rozhraní, Modelování business procesů, komunikace, shoda a legislativa, počítače, řízení obsahu, hardware, řízení informací, Internet, infrastruktura, vývoj softwaru, řízení projektů, bezpečnost, standardy, úložiště, přenos hlasu a podobně."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Informační technologie"@cs;
