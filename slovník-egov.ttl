                  dct:title  "český překlad výkladového slovníku TOGAF"@cs
                ];
        slovníky:definující-ustanovení  <https://opendata.eselpoint.cz/esel-esb/eli/cz/sb/2018/82/2018-05-28/dokument/norma/cast_1/par_2/pism_l> .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/digitálně-přívětivá-legislativa>
        rdf:type         skos:Concept , slovníky:třída , slovníky:pojem , vsgov:typ-objektu-práva;
        dct:description  "Způsob tvorby právních předpisů, který zajišťuje jejich snadnou implementovatelnost do informačních systémů. DPL klade důraz na jednoznačnost procesů, využívání sdíleného datového fondu a odstranění nadbytečných analogových bariér (např. povinnost předkládat papírové doklady), čímž vytváří přímý podklad pro byznys architekturu veřejné správy."@cs;
        skos:altLabel    "DPL"@cs;
        skos:definition  "Digitálně přívětivá legislativa je taková legislativa, která je od počátku navrhována s ohledem na následnou digitální realizaci. Umožňuje efektivní výkon veřejné správy prostřednictvím informačních systémů, minimalizuje administrativní zátěž využitím principu sdílení dat a je srozumitelná jak pro lidi, tak pro technologické zpracování."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Digitálně přívětivá legislativa"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "Výklad OHA"@cs
                ] .

