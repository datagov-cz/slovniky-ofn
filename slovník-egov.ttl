                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/úroveň-služby>
        rdf:type         slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "SL"@cs;
        skos:definition  "Soubor kvalitativních a kvantitativních parametrů (SLA/OLA), které definují podmínky, za nichž je výstup činnosti dostupný a konzumovatelný klientem. Je nezbytným prostředníkem mezi účinností (výrobou výstupu) a účelností (dosažením výsledku), neboť určuje reálnou využitelnost výstupu v praxi."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Úroveň služby"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "Výklad OHA"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/mobilní-aplikace-mv-co-dělat-když>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        dct:description  "Aplikace poskytuje přehledný návod pro řešení vybraných životních situací ve vztahu k úřadům veřejné správy České republiky. Aplikace zobrazuje postup vyřízení, navrhuje, co je třeba doložit pro dané řešení, a vypočítává oficiální lhůty pro podání žádostí nebo podání informace ve vztahu občan - stát. Dále zobrazuje na mapě polohu nejbližších úřadů, Czech POINTů a policejních stanic."@cs;
        skos:definition  "Aplikace pro přehledný návod řešení životních situací."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Mobilní aplikace MV \\"Co dělat, když …\\""@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "Výklad OeG"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/významný-informační-systém>
        rdf:type                        skos:Concept , slovníky:třída , vsgov:typ-objektu-práva , slovníky:pojem;
        dct:description                 "Dle Vyhlášky č. 317/2014 Sb. o významných informačních systémech a jejich určujících kritériích je za jeho určení odpovědný správce systému."@cs;
        skos:altLabel                   "VIS"@cs;
        skos:definition                 "Informační systém spravovaný orgánem veřejné moci, který není kritickou informační infrastrukturou ani informačním systémem základní služby, a u kterého narušení bezpečnosti informací může omezit nebo výrazně ohrozit výkon působnosti orgánu veřejné moci."@cs;
        skos:inScheme                   <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel                  "Významný informační systém"@cs;
