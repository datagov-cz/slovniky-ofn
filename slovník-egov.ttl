                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/řídící-procesy>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Skupina procesů normy ISO/IEC 20000, která zahrnuje Správu změn a Správu konfigurací."@cs;
