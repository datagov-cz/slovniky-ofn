                  dct:title  "český překlad výkladového slovníku TOGAF"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/analýza-výpadku-služby>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Činnost vedoucí k určení příčin jednoho či více přerušení poskytování služby IT. Analýza výpadku služby identifikuje příležitosti k zlepšení procesů a nástrojů poskytovatele služeb IT, a to nejen v infrastruktuře IT. Analýza je časově omezená projektu podobná činnost, spíše než průběžný analytický proces."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Analýza výpadku služby"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/správa-aplikací>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Funkce odpovědná za správu aplikací v průběhu jejich životního cyklu."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
