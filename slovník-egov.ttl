<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/služba-konektivity>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Servisní oblast externí entity v rámci technického referenčního modelu (TRM), která poskytuje konektivitu pro komunikaci přes tři úrovně (globální, regionální a lokální)."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Služba konektivity"@cs;
