                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/protiopatření>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Termín Protiopatření bývá používán pro všechny typy řízení, nejčastěji ale v souvislosti s opatřeními, která zvyšují odolnost, odolnost proti poruchám nebo spolehlivost IT služby."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Protiopatření"@cs;
