                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/poskytovatel-ict-služby>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-subjektu-práva , slovníky:třída;
        skos:definition  "Organizace nebo útvar, který odpovídá za zajišťování poskytování ICT služeb."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
