                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "český překlad výkladového slovníku TOGAF"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/uživatel>
        rdf:type                        slovníky:pojem , slovníky:třída , skos:Concept , vsgov:typ-subjektu-práva;
        dct:description                 "Jakákoliv osoba - interní zaměstnanec či externí subjekt, autentizovaná i anonymní, která při své činnosti využívá nebo spravuje aktiva ve vlastnictví či správě organizace. Může jím být i jiný systém, nebo aplikace."@cs;
        skos:definition                 "Osoba, organizace nebo funkční jednotka používající služby informačního systému."@cs , "(též Spotřebitel) Fyzická nebo právnická osoba anebo orgán veřejné moci, které využívají aktiva."@cs;
        skos:inScheme                   <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel                  "Uživatel"@cs;
