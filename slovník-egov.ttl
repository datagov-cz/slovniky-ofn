                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/správa-dodavatelů>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Proces zajišťující, že všechny dodavatelské smlouvy podporují potřeby businessu a že všichni dodavatelé plní své smluvní závazky."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
