                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/podpůrná-smlouva>
        rdf:type         slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "UC"@cs;
        skos:definition  "Smlouva mezi dodavatelem služeb IT a třetí stranou. Třetí strana dodává zboží nebo služby, které podporují dodávku služby IT zákazníkovi. Podpůrná smlouva definuje cíle a odpovědnosti, které jsou požadovány za účelem splnění cílů úrovně služeb v rámci SLA."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Podpůrná smlouva"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

