                  schema:url  "https://pubs.opengroup.org/architecture/togaf91-doc/arch/"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/artefakt>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Fyzický kus dat, který je užit nebo vytvořen při procesu vývoje softwaru nebo při nasazení a činnosti systému."@cs;
