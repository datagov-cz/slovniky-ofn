                  schema:url  "https://pubs.opengroup.org/architecture/archimate2-doc/chap03.html#_Toc371945162"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/investiční-položka>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Aktivum, které je předmětem zájmu Správy financí (Financial Management), protože překračuje dohodnutou finanční hodnotu."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
