                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/logická-aplikační-komponenta>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Zapouzdření aplikační funkcionality, které je nezávislé na konkrétní implementaci. Např. klasifikace všech aplikací pro zpracování požadavků na nákup v podniku."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
