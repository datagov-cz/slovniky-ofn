                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/požadavek-na-změnu>
        rdf:type         slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "RFC"@cs;
        skos:definition  "Formální návrh na provedení změny. RFC obsahuje detaily navrhované změny a může být zaznamenán papírově nebo elektronicky. Pojem RFC je často nesprávně používán ve smyslu záznamu o změně nebo ve smyslu změny samotné."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
