                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "ITIL v3, Slovníček termínů, definic a zkratek, itSMF Czech Republic, o.s.,"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/spolehlivost>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Míra, určující, jak dlouho může konfigurační položka nebo služba IT provádět svoji dohodnutou funkci bez přerušení. Obvykle je měřena jako MTBF (Střední doba mezi poruchami)nebo MTBSI (Střední doba mezi incidenty). Termín spolehlivost se užívá též pro vyjádření pravděpodobnosti toho, že proces, funkce a podobně dodá očekávané výstupy. Viz Dostupnost."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Spolehlivost"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
