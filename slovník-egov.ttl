                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://pubs.opengroup.org/architecture/togaf91-doc/arch/"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/dokument>
        rdf:type                        skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition                 "Dokument je graficky zaznamenaná informace v papírové nebo elektronické formě. Např. specifikace politik, dohoda o úrovni služeb, záznam incidentu, schéma uspořádání počítačového sálu."@cs , "Každá písemná, obrazová, zvuková nebo jiná zaznamenaná informace, ať již v podobě analogové či digitální, která byla vytvořena původcem nebo byla původci doručena."@cs;
        skos:inScheme                   <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel                  "Dokument"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ];
        slovníky:definující-ustanovení  <https://opendata.eselpoint.cz/esel-esb/eli/cz/sb/2004/499/2025-01-01/dokument/norma/cast_1/hlava_1/par_2/pism_e> .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/interakce>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Vazba mezi architektonickými stavebními bloky (např. službami či komponentami), která představuje komunikaci či využití."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Interakce"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "český překlad výkladového slovníku TOGAF"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/analýza-stromu-poruch>
        rdf:type         slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "FTA"@cs;
        skos:definition  "Technika, která může být použita pro zjištění řetězce událostí, které vedou k problému. Analýza stromu poruch reprezentuje řetězec událostí zobrazených v diagramu za použití booleovské notace."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Analýza stromu poruch"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/služba-businessu>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Služba IT, která přímo podporuje proces businessu, na rozdíl od služby infrastruktury, jež je využívaná interně poskytovatelem služeb IT a obvykle není viditelná pro business. Termín služba businessu znamená zároveň službu, kterou obchodní jednotky dodávají zákazníkům businessu. Např. dodávka finančních služeb zákazníkovi banky nebo dodávka zboží zákazníkovi maloobchodu. Úspěšné dodání služby businessu často závisí na jedné nebo více službách IT."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Služba businessu"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/seznam-dovedností>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Dovednost je schopnost vykonávat pracovní činnost a příspívat k efektivnímu vykonávání úkolu. Seznam dovedností dokumentuje definice dovedností."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Seznam dovedností"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "český překlad výkladového slovníku TOGAF"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/slouží>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        dct:description  "Název vazby dle standardu ArchiMate. "@cs;
        skos:definition  "Použití služeb procesy, funkcemi, nebo interakcí a přístupem k rozhraní rolemi, komponentami nebo spoluprací."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Slouží"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://pubs.opengroup.org/architecture/archimate2-doc/chap07.html#_Toc371945214"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/životní-událost>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        dct:description  "Základní charakteristické znaky životní události:\
• něco, co se stane občanovi v jeho životě nebo se rozhodne něco změnit, ať už je tento občan v roli fyzické či právnické osoby,\
• touto změnou vzniknou danému občanovi nová práva či povinnosti vůči veřejné správě,\
• vyřízení těchto práv a povinností je často podmíněno konkrétní životní situací občana,\
• tato práva a povinnosti upravuje více právních předpisů, typicky v rámci několika agend.\
Pro veřejnou správu se životní událostí rozumí změna relevantních atributů určujících aktuální stav klienta, ze kterého pro něj na základě platných právních předpisů vyplývají určitá práva a povinnosti."@cs;
        skos:definition  "Objektivní skutečnost nebo volní úkon klienta, který nastává v určitém čase a má právní či věcný význam pro vztah k veřejné správě. Je to spouštěč (trigger), který mění stávající stav klienta a vyvolává potřebu interakce."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Životní událost"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "Výklad OHA"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/international-standards-organisation>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-subjektu-práva , slovníky:třída;
        skos:definition  "Viz International Organization for Standardization (ISO). Mezinárodní organizace pro standardizaci (ISO) je celosvětově největším producentem norem. ISO je nevládní organizací, jež je tvořena sítí národních normalizačních institucí 156 zemí. Další informace o ISO jsou dostupné na http://www.iso.org/."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "International Standards Organisation"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/požadavek-na-architektonickou-práci>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Dokument, který je zaslán od sponzorující organizace organizaci aplikující architekturu, aby spustila cyklus rozvoje architektury. Požadavek na architektonickou práci může být vytvořen, jako výstup přípravné fáze, jako výsledek schváleného požadavku na změnu architektury, nebo jako referenční podmínky pro architektonickou práci pocházející z plánování migrace."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Požadavek na architektonickou práci"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "český překlad výkladového slovníku TOGAF"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/benchmark>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Systematický proces měření a porovnávání produktů či procesů s cílem stanovit srovnávací úroveň (benchmark). Prostřednictvím analýzy výkonu a hledání nejlepších řešení u srovnatelných subjektů umožňuje sdílení zkušeností a přebírání nejlepší praxe (best practice)."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Benchmark"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "Výklad OHA"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/databáze>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
