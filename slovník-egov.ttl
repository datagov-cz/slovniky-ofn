<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/optimalizace-poskytování-služeb>
        rdf:type         slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "SPO"@cs;
        skos:definition  "Analýza peněžních prostředků a omezení služby IT sloužící k rozhodnutí, zda jiný způsob dodávky služby může snížit náklady nebo zlepšit kvalitu."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
