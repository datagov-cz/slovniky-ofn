                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/kapacita>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Maximální propustnost, kterou může konfigurační položka nebo služba IT poskytovat při dodržení dohodnutého cíle úrovně služeb. Pro některé typy konfiguračních položek může kapacita představovat velikost nebo množství, např. u diskových jednotek."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Kapacita"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/digitální-government>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        dct:description  "Jedná se o totéž jako eGovernment (synonymum)."@cs;
        skos:definition  "Digitální veřejná správa, která předpokládá používání digitálních technologií jakožto integrované části strategií modernizace vlád k vytvoření veřejné hodnoty. Opírá se o ekosystém digitálního státu složený z vládních aktérů, nevládních organizací, podniků, sdružení občanů a jednotlivců, kteří podporují tvorbu dat, služeb a obsahu prostřednictvím interakcí s vládou."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Digitální Government"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://digitalnicesko.gov.cz/faq/"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/interní-poskytovatel-služeb>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-subjektu-práva , slovníky:třída;
        skos:definition  "Poskytovatel služeb IT, jenž je součástí stejné organizace jako jeho zákazník. Poskytovatel služeb IT může mít interní i externí zákazníky. Viz Poskytovatel služeb prvního typu, Poskytovatel služeb druhého typu, Insourcing."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Interní poskytovatel služeb"@cs;
