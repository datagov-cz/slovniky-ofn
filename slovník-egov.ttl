                ];
        slovníky:definující-ustanovení  <https://opendata.eselpoint.cz/esel-esb/eli/cz/sb/2009/111/2025-07-01/dokument/norma/cast_1/hlava_1/par_2/pism_e> .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/smart>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Akronym, který by nám měl umožnit lepší zapamatování, že cíle dohody o úrovni služeb nebo projektových plánů mají být “Specific (specifické), Measurable(měřitelné), Achievable (dosažitelné), Relevant (relevantní) and Time based (časově proveditelné)\\"."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "SMART"@cs;
