                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/formulářový-agendový-informační-systém>
        rdf:type         slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel    "FAIS"@cs;
        skos:definition  "Formulářový AIS (FAIS) je komponentou ISZR (Informační systém základních registrů), který prostřednictvím speciálních formulářově orientovaných služeb umožňuje požádat o výdej více údajů ze základních registrů a následně zprostředkuje dávkové vydání těchto hromadných údajů. Využívá se pro případy, kdy je stanoveno zákonným zmocněním, že se využívají referenční údaje ve skupinách více subjektů. Takovým případem jsou například výdeje voličských seznamů."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Formulářový agendový informační systém"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://archi.gov.cz/_media/dokumenty:navazujici_dokument_c_4_narodni_architektonicky_plan.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/komunikační-síť>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Množina produktů, konceptů a služeb, které umožňují propojení počítačových systémů za účelem přenosu dat (např. hlas, obraz)."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
