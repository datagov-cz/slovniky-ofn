                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/postup>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Dokument obsahující kroky, které specifikují, jak uskutečnit činnost. Postupy jsou definovány jako část procesů."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Postup"@cs;
