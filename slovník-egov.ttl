<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/identifikátor-orgánu-veřejné-moci>
        rdf:type                        slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:definition                 "Kód sloužící k jednoznačnému určení orgánu veřejné moci."@cs;
        skos:inScheme                   <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
