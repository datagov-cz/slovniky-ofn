                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/kvalifikace>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Činnost, která zajišťuje, že infrastruktura IT odpovídá a je správně konfigurována pro podporu aplikace nebo služby IT."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
