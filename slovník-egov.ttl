                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/insourcing>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Synonymum pro využití vnitřních zdrojů."@cs;
