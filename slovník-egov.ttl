                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/popis-pracovní-pozice>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Dokument stanovující role, odpovědnosti, dovednosti a znalosti potřebné pro konkrétní osobu. Jeden popis pracovní pozice může obsahovat několik rolí, například role manažera Správy konfigurací a manažera Správy změn mohou být prováděny jednou osobou."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Popis pracovní pozice"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/procesní-manažer>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-subjektu-práva , slovníky:třída;
        skos:definition  "Role odpovědná za provozní správu procesu. Mezi odpovědnosti procesního manažera spadá plánování a koordinace všech činností požadovaných pro provedení, monitorování procesu a jeho vykazování. Projeden proces může existovat více procesních manažerů, např. regionální manažeři změn nebo manažeři kontinuity služeb IT pro každé datové centrum. Role procesního manažera je často přiřazována osobě, která vykonává roli vlastníka procesu, avšak tyto role mohou být u větších organizací odděleny."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Procesní manažer"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/kmen>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        dct:description  "Je to 'jediný zdroj pravdy' (Single Source of Truth), který slouží jako společný referenční základ pro různé procesy a informační systémy, čímž zajišťuje datovou konzistenci napříč celou architekturou."@cs;
        skos:definition  "Kmen představuje autoritativní, centrálně spravovaný a dlouhodobě platný soubor údajů o klíčových entitách organizace (např. klientech, zaměstnancích, materiálech nebo majetku)."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Kmen"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "Výklad OHA"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/nákladové-středisko>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Podniková jednotka nebo projekt, pro které jsou sledovány náklady. Nákladové středisko neúčtuje za poskytované služby. Poskytovatel služeb IT může fungovat jako nákladové středisko nebo jako ziskové středisko."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Nákladové středisko"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/governance-architektury>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Způsob jakým jsou podnikové architektury a další architektury řízeny a kontrolovány na úrovni podniku."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Governance architektury"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://www.tx.cz/slovnik/togaf/governance-architektury"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/dostupnost>
        rdf:type         vsgov:typ-objektu-práva , slovníky:pojem , slovníky:třída , skos:Concept;
        skos:definition  "Schopnost konfigurační položky nebo služby IT provádět dohodnutou funkci, když je požadována. Dostupnost je určována ze spolehlivosti, udržovatelnosti, servisovatelnosti, výkonnosti a bezpečnosti. Dostupnost je zpravidla vypočítávána jako procentní podíl. Výpočet je často založen na dohodnuté provozní době služby a odstávkách. Nejlepší praktikou je počítat dostupnost z výsledků měření výstupů služby IT pro business."@cs , "V kontextu IT systémů se jedná o pravděpodobnost, že system bude pro uživatele použitelný."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Dostupnost"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "ITIL v3, Slovníček termínů, definic a zkratek, itSMF Czech Republic, o.s.,"@cs
                ];
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/budoucí-cílová-architektura>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Popis budoucího cílového stavu architektury (podniku nebo řešení) vyvíjeného pro organizaci. Může být vyvinuto několik budoucích mezistavů (jako plán) za účelem ukázání postupného vývoje architektury až do cílového stavu."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Budoucí (cílová) architektura"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://pubs.opengroup.org/architecture/togaf91-doc/arch/"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/plán>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Detailní návrh definující činnosti a zdroje nezbytné k dosažení stanovených cílů. Například plán zavedení nové služby IT nebo procesu. ISO/IEC 20000 požaduje plán pro správu každého procesu Správy služeb IT."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Plán"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/množstevní-úspory>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Snížení průměrných nákladů, které je umožněno zvýšením využití služby IT nebo aktiva."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Množstevní úspory"@cs;
