                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://pubs.opengroup.org/architecture/togaf91-doc/arch/"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/integrita>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Bezpečnostní princip, který zajišťuje, že data a konfigurační položky jsou modifikovány pouze oprávněným personálem a činnostmi. Integrita uvažuje všechny možné příčiny modifikace, včetně softwarových a hardwarových poruch, živelních událostí a lidských zásahů."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Integrita"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/adresa>
        rdf:type                        slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída , skos:Concept;
        skos:altLabel                   "Adresa"@cs;
        skos:definition                 "Kombinace názvu okresu, názvu obce nebo vojenského újezdu, názvu části obce nebo v případě hlavního města Prahy názvu katastrálního území a názvu obvodu, čísla popisného nebo evidenčního, názvu ulice a čísla orientačního a dále zvláštních údajů pro doručování prostřednictvím poštovních služeb, která jednoznačně určuje adresní místo."@cs;
        skos:inScheme                   <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel                  "Adresa"@cs;
        slovníky:definující-ustanovení  <https://opendata.eselpoint.cz/esel-esb/eli/cz/sb/2009/111/2025-07-01/dokument/norma/cast_1/hlava_4/par_29/odst_1/pism_h> .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/vlastník-procesu>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-subjektu-práva , slovníky:třída;
        skos:definition  "Role odpovídající za splnění účelu procesu. Odpovědnostmi vlastníka procesu jsou sponzorování, návrh a řízení změn procesu a průběžné zlepšování procesu a jeho metrik. Role je často přiřazena tomu, kdo zastává roli procesního manažera, avšak tyto role mohou být u větších organizací odděleny."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Vlastník procesu"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/požadavek>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Vyjádření, jež převádí nebo vyjadřuje potřebu a její asociované omezení."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Požadavek"@cs;
