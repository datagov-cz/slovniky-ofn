                  dct:title  "český překlad výkladového slovníku TOGAF"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/revize>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Vyhodnocení změny, problému, procesu, projektu atd. Revize jsou typicky prováděny v určitých bodech životního cyklu, obzvláště po uzavření. Účelem revize je zajistit, aby byly poskytnuty všechny dodávky, a identifikovat příležitosti pro zlepšení."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Revize"@cs;
