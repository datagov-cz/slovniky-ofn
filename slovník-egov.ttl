                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/správa-výkonnosti>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Proces, jenž odpovídá za každodenní činnosti Správy kapacit. Zahrnuje monitorování, detekci prahových úrovní, analýzu výkonnosti a ladění, dále implementaci změn vztahujících se k výkonnosti a ke kapacitám."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Správa výkonnosti"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type    <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
