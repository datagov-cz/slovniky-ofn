                  schema:url  "https://is.muni.cz/el/1433/podzim2015/PV214/um/itil_2011_czech_glossary_v2.0.pdf"^^xsd:anyURI
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/elektronická-identita>
        rdf:type         slovníky:pojem , slovníky:třída , skos:Concept , vsgov:typ-objektu-práva;
        dct:description  "Při prokazování totožnosti například občanským průkazem, se předkládá určitý soubor informací o osobě, který je na tomto průkazu uveden. Stejně tak tomu je ve světě IT, opět se předkládá souhrn informací o osobě, tentokrát v digitální podobě."@cs;
        skos:altLabel    "eID"@cs;
        skos:definition  "Dříve byl známý spíše pojem digitální identita, která je obdobou fyzické identity, nezbytné ve světě informačních systémů a internetu. Je to sada vlastností, které jednoznačně určují konkrétní osobu. Je potřeba k prokázání totožnosti el. způsobem a předpokládá používání osobních identifikačních údajů v elektronické podobě, které jednoznačně identifikují určitou fyzickou či právnickou osobu nebo fyzickou osobu zastupující právnickou osobu."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Elektronická identita"@cs;
        <https://slovník.gov.cz/definující-nelegislativní-zdroj>
                [ rdf:type   <https://slovník.gov.cz/generický/digitální-objekty/pojem/digitální-objekt>;
                  dct:title  "Výklad OeG"@cs
                ] .

<https://slovník.gov.cz/slovník-pojmů-egovenmentu/pojem/plató-přechodová-architektura>
        rdf:type         skos:Concept , slovníky:pojem , vsgov:typ-objektu-práva , slovníky:třída;
        skos:definition  "Relativně stabilní stav architektury, který existuje v průběhu určitého časového úseku."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
