        skos:definition  "Detailní rozpracování architektury řešení, popisující konstrukci a „výrobní“ postup implementace komponenty řešení – zavedení procesu, naprogramování nebo parametrizace aplikace apod."@cs;
        skos:inScheme    <https://slovník.gov.cz/slovník-pro-jednotné-měsíční-hlášení>;
        skos:prefLabel   "Design řešení"@cs;
